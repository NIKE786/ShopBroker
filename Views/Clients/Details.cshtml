@model InsuranceClient
@{ ViewData["Title"] = Model.FullName; }
<div class="d-flex justify-content-between mb-3">
  <h2>@Model.FullName</h2>
  <a asp-controller="Policies" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-primary">+ New Policy</a>
</div>
<p>📞 @Model.Phone &nbsp; ✉️ @Model.Email<br />📍 @Model.Address<br />DOB: @(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</p>
<h5>Policies</h5>
<table class="table table-sm">
  <thead><tr><th>Policy #</th><th>Company</th><th>Type</th><th>Premium</th><th>Next Due</th><th>Status</th><th></th></tr></thead>
  <tbody>
  @foreach (var p in Model.Policies)
  {
    <tr><td>@p.PolicyNumber</td><td>@p.Company?.Name</td><td>@p.PolicyType</td><td>₹@p.PremiumAmount.ToString("N2")</td><td>@p.NextPremiumDue.ToString("dd MMM yyyy")</td><td>@p.Status</td>
        <td><a asp-controller="Policies" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>
  }
  </tbody>
</table>
