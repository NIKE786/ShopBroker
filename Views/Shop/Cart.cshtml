@model List<CartLine>
@{ ViewData["Title"] = "Cart"; }
<h2 class="mb-3">Aapka Cart</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">Cart khali hai. <a asp-action="Index">Shopping shuru karein</a></div>
}
else
{
    <form asp-action="UpdateCart" method="post">
      <table class="table align-middle">
        <thead><tr><th>Product</th><th>Price</th><th style="width:120px">Qty</th><th class="text-end">Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
              <td>@l.Name</td>
              <td>₹@l.Price.ToString("N2")</td>
              <td><input type="number" name="qty[@l.ProductId]" value="@l.Qty" min="0" max="@Math.Min(l.Stock, 99)" class="form-control form-control-sm" /></td>
              <td class="text-end">₹@l.Total.ToString("N2")</td>
              <td class="text-end"><button type="submit" asp-action="Remove" asp-route-id="@l.ProductId" class="btn btn-sm btn-outline-danger">Remove</button></td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3" class="text-end">Grand Total</th><th class="text-end">₹@Model.Sum(x => x.Total).ToString("N2")</th><th></th></tr></tfoot>
      </table>
      <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Aur shopping</a>
        <div>
          <button class="btn btn-outline-primary">Update cart</button>
          <a asp-action="Checkout" class="btn btn-success">Checkout →</a>
        </div>
      </div>
    </form>
}
