@model Order
@{ ViewData["Title"] = "Order Confirmed"; }
<div class="alert alert-success"><h4 class="mb-1">✅ Order #@Model.Id place ho gaya!</h4>Shukriya, @Model.CustomerName. Status: <strong>@Model.Status</strong> (@Model.PaymentMethod)</div>
<table class="table">
  <thead><tr><th>Product</th><th>Qty</th><th class="text-end">Price</th><th class="text-end">Total</th></tr></thead>
  <tbody>
  @foreach (var i in Model.Items)
  {
      <tr><td>@i.Product?.Name</td><td>@i.Quantity</td><td class="text-end">₹@i.UnitPrice.ToString("N2")</td><td class="text-end">₹@((i.UnitPrice * i.Quantity).ToString("N2"))</td></tr>
  }
  </tbody>
  <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">₹@Model.TotalAmount.ToString("N2")</th></tr></tfoot>
</table>
<p><strong>Deliver to:</strong> @Model.Address (@Model.Phone)</p>
<a asp-action="Index" class="btn btn-primary">Aur shopping</a>
