@model BrokerDashboardVM
@{ ViewData["Title"] = "Broker Dashboard"; }
<h2 class="mb-3">Insurance Broker Dashboard</h2>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted">Clients</div><div class="stat">@Model.Clients</div></div></div>
  <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted">Active Policies</div><div class="stat">@Model.ActivePolicies</div></div></div>
  <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted">Due in 30 days</div><div class="stat text-warning">@Model.DueIn30Days</div></div></div>
  <div class="col-6 col-md-3"><div class="card p-3"><div class="text-muted">Overdue</div><div class="stat text-danger">@Model.Overdue</div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Premium collected (this month)</div><div class="stat">₹@Model.PremiumThisMonth.ToString("N0")</div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Commission (this month)</div><div class="stat text-success">₹@Model.CommissionThisMonth.ToString("N0")</div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Commission (total)</div><div class="stat text-success">₹@Model.CommissionTotal.ToString("N0")</div></div></div>
</div>
<h5>Upcoming / Overdue Premiums</h5>
<partial name="~/Views/Policies/_PolicyTable.cshtml" model="Model.Upcoming" />
