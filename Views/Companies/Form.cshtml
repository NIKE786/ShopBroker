@model InsuranceCompany
@{ ViewData["Title"] = Model.Id == 0 ? "New Company" : "Edit Company"; }
<h2 class="mb-3">@ViewData["Title"]</h2>
<form method="post" class="row g-3">
  <input type="hidden" asp-for="Id" />
  <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
  <div class="col-md-3"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div>
  <div class="col-md-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
  <div class="col-12"><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
