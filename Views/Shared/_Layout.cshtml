<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ShopBroker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" asp-controller="Shop" asp-action="Index">ShopBroker</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="MyOrders">My Orders</a></li>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Broker"))
        {
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Insurance Broker</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Broker" asp-action="Index">Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Clients" asp-action="Index">Clients</a></li>
                <li><a class="dropdown-item" asp-controller="Policies" asp-action="Index">Policies</a></li>
                <li><a class="dropdown-item" asp-controller="Policies" asp-action="Dues">Premium Dues / Renewals</a></li>
                <li><a class="dropdown-item" asp-controller="Companies" asp-action="Index">Companies</a></li>
                <li><a class="dropdown-item" asp-controller="Broker" asp-action="Commission">Commission Report</a></li>
              </ul>
            </li>
        }
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Products">Products</a></li>
              </ul>
            </li>
        }
      </ul>
      <a class="btn btn-warning me-3" asp-controller="Shop" asp-action="Cart">🛒 Cart <span class="badge bg-dark">@CartHelper.Count(Context.Session)</span></a>
      <partial name="_LoginPartial" />
    </div>
  </div>
</nav>
<main class="container py-4">
    @if (TempData["Msg"] != null) { <div class="alert alert-success">@TempData["Msg"]</div> }
    @if (TempData["Err"] != null) { <div class="alert alert-danger">@TempData["Err"]</div> }
    @RenderBody()
</main>
<footer class="text-center text-muted py-3 border-top">&copy; ShopBroker</footer>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
